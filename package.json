{
  "name": "slack-opener",
  "displayName": "Slack Opener",
  "description": "Open Slack archive permalinks and slack:// links in the Slack app, not the browser.",
  "version": "0.1.2",
  "publisher": "codenoevil",
  "author": "David Bitton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeNoEvil/vscode-slack-opener.git"
  },
  "bugs": {
    "url": "https://github.com/CodeNoEvil/vscode-slack-opener/issues"
  },
  "homepage": "https://github.com/CodeNoEvil/vscode-slack-opener#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["slack", "permalink", "slack://", "opener", "archive"],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "slackOpener.open",
        "title": "Open Slack URL",
        "category": "Slack"
      }
    ],
    "configuration": {
      "title": "Slack Opener",
      "properties": {
        "slackOpener.teamId": {
          "type": "string",
          "default": "",
          "description": "Workspace team ID (T…) used when a Slack URL has no team. Find it in a slack:// URL or in the Slack desktop app under the workspace menu."
        },
        "slackOpener.channelId": {
          "type": "string",
          "default": "",
          "description": "Channel ID (C…) used when a Slack URL has a team but no channel, or when opening a workspace home URL. Leave empty if you only open archive permalinks."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/slackUrl.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
